{
  "_instructions": {
    "purpose": "Demo series/episode fixture — 1 episode video + clothing and non-clothing products, wired end-to-end through the AI model API.",
    "codeRefs": {
      "outboundPayload": "backend/src/common/services/aiIngest.service.js → buildAnalyzePayload / buildEpisodeAnalyzeEntry / buildProductAnalyzeEntry",
      "outboundRequest": "backend/src/common/services/aiIngest.service.js → postAnalyzeJob (POST {AI_SERVICE_URL}/v1/analyze/jobs)",
      "callbackHandler": "backend/src/modules/ai/ai.controller.js → applyProductCueResults",
      "storedShape": "backend/src/modules/series/series.model.js → episodeProductCueSchema"
    },
    "media": {
      "episodeVideo": "c:\\Users\\PushkarLS68\\Downloads\\WhatsApp Video 2026-07-31 at 12.38.21 AM.mp4",
      "clothing": ["shirt.png"],
      "nonClothing": ["earrings.png", "headphones.png", "specs.png"]
    },
    "purchaseLink": "https://purchase.link/demo (same demo link on every product)",
    "flow": [
      "1. POST /api/v1/user/series                      → seriesId",
      "2. POST /api/v1/user/series/:id/upload/presign   → uploadUrl + key (per file)",
      "3. PUT  uploadUrl (S3)                           → upload bytes",
      "4. POST /api/v1/user/series/:id/episodes         → { videoKey, title, order }",
      "5. POST /api/v1/user/series/:id/products         → { imageKey, title, purchaseLink, category }",
      "6. PATCH /api/v1/user/series/:id { status: 'submitted' } → backend builds analyzeJobRequest and POSTs it to the AI model",
      "7. AI model POSTs callbackUrl → backend writes episode.productCues + uploads product-cues.json to S3"
    ]
  },

  "step1_createSeriesRequest": {
    "method": "POST",
    "url": "/api/v1/user/series",
    "headers": { "Authorization": "Bearer <userJwt>", "Content-Type": "application/json" },
    "body": {
      "name": "Demo Shoppable Series 31 Jul",
      "type": "micro_drama",
      "episodeCount": 1,
      "productCount": 4
    }
  },

  "step2_presignRequests": [
    {
      "method": "POST",
      "url": "/api/v1/user/series/{seriesId}/upload/presign",
      "body": {
        "assetType": "episode",
        "fileName": "WhatsApp Video 2026-07-31 at 12.38.21 AM.mp4",
        "contentType": "video/mp4"
      }
    },
    {
      "method": "POST",
      "url": "/api/v1/user/series/{seriesId}/upload/presign",
      "body": { "assetType": "product", "fileName": "shirt.png", "contentType": "image/png" }
    },
    {
      "method": "POST",
      "url": "/api/v1/user/series/{seriesId}/upload/presign",
      "body": { "assetType": "product", "fileName": "earrings.png", "contentType": "image/png" }
    },
    {
      "method": "POST",
      "url": "/api/v1/user/series/{seriesId}/upload/presign",
      "body": { "assetType": "product", "fileName": "headphones.png", "contentType": "image/png" }
    },
    {
      "method": "POST",
      "url": "/api/v1/user/series/{seriesId}/upload/presign",
      "body": { "assetType": "product", "fileName": "specs.png", "contentType": "image/png" }
    }
  ],

  "step4_registerEpisodeRequest": {
    "method": "POST",
    "url": "/api/v1/user/series/{seriesId}/episodes",
    "body": {
      "title": "Demo Episode 1",
      "order": 1,
      "videoKey": "users/6a0226f4b660482225067665/series/6b1100aa2c9f4a0011000001/episodes/1785000000001-11111111-1111-4111-8111-111111111111-WhatsApp_Video_2026-07-31.mp4",
      "productCues": []
    }
  },

