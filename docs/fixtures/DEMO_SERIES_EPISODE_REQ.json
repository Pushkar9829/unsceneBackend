  "step6_submitRequest": {
    "method": "PATCH",
    "url": "/api/v1/user/series/{seriesId}",
    "body": { "status": "submitted" },
    "note": "Triggers queueSeriesAiAnalysis → POST {AI_SERVICE_URL}/v1/analyze/jobs with analyzeJobRequest below. Manual retry: POST /api/v1/user/series/{seriesId}/ai/analyze"
  },

